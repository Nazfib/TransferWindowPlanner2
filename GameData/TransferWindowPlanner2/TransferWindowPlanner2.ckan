identifier: TransferWindowPlanner2
name: Transfer Window Planner 2
abstract: >-
  A new transfer window planner mod.
  Inspired by TriggerAu's TWP, using math routines from MechJeb.
license:
  - MIT
  - CC-BY-4.0
comment: Indexed by author. Please report any problems at the repository bugtracker.
resources:
  homepage: https://discordapp.com/invite/ZGbR6nv
depends:
  - name: MechJeb2
    min_version: 2.15.0.0
  - name: ClickThroughBlocker
conflicts:
  - name: TransferWindowPlanner
  - name: TransferWindowPlannerFork
install:
  - find: TransferWindowPlanner2
    install_to: GameData
